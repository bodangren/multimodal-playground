# API Key Configuration
# Single API key for all providers (OpenRouter recommended for most use cases)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model Configuration (optional - defaults will be used if not set)
OPENROUTER_TEXT_MODEL=openrouter/free
OPENROUTER_SPEECH_MODEL=openai/gpt-audio-mini
OPENROUTER_TRANSCRIPTION_MODEL=openrouter/free
OPENROUTER_VIDEO_MODEL=alibaba/wan-2.6

# API Authentication (optional - for production deployments)
VERCEL_ENV=development
API_SECRET_KEY=your_secret_key_here

# Scripts (optional - for CLI testing)
# TRANSCRIBE_AUDIO_PATH=/path/to/audio/file.mp3
# TRANSCRIBE_MODEL_ID=openrouter/free
# SPEECH_VOICE=alloy
# SPEECH_MODEL_ID=tts-1
# STRUCTURED_ROUTE_URL=http://127.0.0.1:3000/api/generate-structured